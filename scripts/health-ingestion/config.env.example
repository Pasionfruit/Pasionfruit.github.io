# Absolute path to the service account's JSON *key file*.
# The service account's email and ID are not enough on their own — you must
# generate a key: Google Cloud Console → IAM & Admin → Service Accounts →
# your account → Keys → Add Key → Create new key → JSON. That downloads the file.
#
# Then share the spreadsheet with the service account's email address as an
# Editor. A service account is a separate identity from your own Google account,
# so it has no access until you share with it explicitly.
#
# This file contains a private key. Keep it outside the repo.
GOOGLE_SERVICE_ACCOUNT_JSON=C:/Users/you/keys/service_account.json

# The long id from the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# Preferred over SPREADSHEET_NAME, which additionally needs the Drive API enabled.
SPREADSHEET_ID=

# Fallback if you would rather match on name (requires the Drive API).
# SPREADSHEET_NAME=Your Spreadsheet Name

# Garmin Connect credentials (required for --api mode only)
GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=yourpassword
