# Google Sheets API (for public reads)
VITE_SHEETS_SPREADSHEET_ID=REPLACE_WITH_YOUR_SPREADSHEET_ID
VITE_SHEETS_API_KEY=REPLACE_WITH_YOUR_GOOGLE_SHEETS_API_KEY

# Google OAuth (for admin sign-in and writes)
VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Apps Script (for authenticated writes only)
VITE_SHEETS_API_BASE_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT/exec

# Todoist API (for the admin Tasks dashboard)
VITE_TODOIST_API_TOKEN=REPLACE_WITH_YOUR_TODOIST_API_TOKEN

# Apple Calendar is NOT configured here — the .ics URL lives in Apps Script
# Project Settings → Script Properties as APPLE_CALENDAR_ICS_URL, so the feed is
# fetched server-side (no CORS problem) and never reaches the browser.

# Gaming / Minecraft — Server Manager API
# Base URL of the Minecraft server manager proxy (Cloudflare Worker; it holds
# the real API key and forwards requests to the Flask backend)
VITE_API_URL=https://cloudflare-worker.abepasion.workers.dev
# X-API-Key sent directly from the browser. Leave empty — the Worker injects
# auth server-side; the header is omitted when this is blank.
VITE_API_KEY=
# Assistant Ace — locally hosted model
# URL of the Cloudflare Worker in front of Ollama. Safe to publish: the Worker
# verifies a Google ID token and only serves the admin account. Never point this
# at a bare tunnel hostname — Ollama has no authentication of its own.
# On the machine running Ollama you can also use http://localhost:11434
# directly, provided OLLAMA_ORIGINS allows this site's origin.
VITE_ACE_BASE_URL=https://ace.abepasion.workers.dev
# Model tag as it appears in `ollama list`. Defaults to qwen3:8b.
VITE_ACE_MODEL=qwen3:8b

# Cloudflare D1 data API (workers/db) — overrides the default worker URL
# for local testing; leave unset in normal use.
# VITE_DB_BASE_URL=https://db.abepasion.workers.dev

# Finance dashboard PIN (4 digits)
# A privacy screen, not a security boundary: like every VITE_* value this is
# compiled into the public bundle, and four digits is 10,000 guesses anyway.
# What it buys is that a glance at your screen, or someone picking up an
# unlocked phone, does not land on your balances. Leave blank to disable.
VITE_FINANCE_PIN=
